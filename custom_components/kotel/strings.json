  "services": {
    "send_command": {
      "name": "Send command",
      "description": "Send an arbitrary command to the device (action from functions.js). Diagnostic use; handle with care.",
      "fields": {
        "device_id": {
          "name": "Device ID",
          "description": "Controller id_name"
        },
        "action": {
          "name": "Action",
          "description": "For example: temp_w_ust, vent_max, start__, stop___"
        },
        "value": {
          "name": "Value",
          "description": "Numeric value for the range field"
        }
      }
    },
    "save_profile": {
      "name": "Save profile",
      "description": "Save the current values as a profile. Boiler and climate profiles are kept in separate lists; the kind is inferred from scopes when omitted.",
      "fields": {
        "name": {
          "name": "Profile name",
          "description": "Up to 40 characters. Boiler and climate names may match."
        },
        "kind": {
          "name": "Profile kind",
          "description": "boiler — boiler settings; climate — climate mode, target and schedule. Inferred from scopes when omitted (boiler by default)."
        },
        "scopes": {
          "name": "What to save",
          "description": "Boiler: boiler. Climate: climate, schedule, climate_sensor (climate and schedule by default)."
        },
        "note": {
          "name": "Note",
          "description": "Free text, up to 200 characters."
        },
        "overwrite": {
          "name": "Overwrite existing",
          "description": "Update the profile if the name already exists."
        },
        "all_schedules": {
          "name": "Save all schedule sets",
          "description": "By default only the active schedule (7/7, 5/2 or 4/1/2) is saved."
        }
      }
    },
    "apply_profile": {
      "name": "Apply profile",
      "description": "Write the profile values to the controller (changed values only). Boiler and climate profiles are applied independently.",
      "fields": {
        "name": {
          "name": "Profile name",
          "description": "Name of a saved profile."
        },
        "kind": {
          "name": "Profile kind",
          "description": "Needed only if the name exists in both lists."
        },
        "scopes": {
          "name": "What to apply",
          "description": "All profile scopes by default."
        },
        "dry_run": {
          "name": "Show changes only",
          "description": "Do not write anything; return the change list."
        },
        "force": {
          "name": "Ignore offline status",
          "description": "Write even when the controller is offline."
        },
        "verify": {
          "name": "Verify result",
          "description": "Wait for the controller to confirm the values."
        }
      }
    },
    "undo_apply": {
      "name": "Undo apply",
      "description": "Restore the values from before the last profile application of the selected kind.",
      "fields": {
        "kind": {
          "name": "Profile kind",
          "description": "Boiler by default."
        },
        "force": {
          "name": "Ignore offline status",
          "description": "Write even when the controller is offline."
        },
        "verify": {
          "name": "Verify result",
          "description": "Wait for the controller to confirm the values."
        }
      }
    },
    "delete_profile": {
      "name": "Delete profile",
      "description": "Delete a saved profile. This cannot be undone.",
      "fields": {
        "name": {
          "name": "Profile name",
          "description": "Name of the profile to delete."
        },
        "kind": {
          "name": "Profile kind",
          "description": "Needed only if the name exists in both lists."
        }
      }
    },
    "rename_profile": {
      "name": "Rename profile",
      "description": "Rename a saved profile.",
      "fields": {
        "name": {
          "name": "Current name",
          "description": "Existing profile name."
        },
        "new_name": {
          "name": "New name",
          "description": "New name, up to 40 characters."
        },
        "kind": {
          "name": "Profile kind",
          "description": "Needed only if the name exists in both lists."
        }
      }
    },
    "list_profiles": {
      "name": "List profiles",
      "description": "Return saved profiles as a service response. Boiler profiles are at the top level and in the boiler block; climate profiles are in the climate block."
    },
    "export_profiles": {
      "name": "Export profiles to a file",
      "description": "Write the selected profiles to a JSON file in /config/kotel_profiles/. Without filters all profiles (boiler and climate) are exported.",
      "fields": {
        "profiles": {
          "name": "Profiles",
          "description": "Profile names (all by default)."
        },
        "kind": {
          "name": "Profile kind",
          "description": "Export only boiler or only climate profiles."
        },
        "to_www": {
          "name": "Put into www for download",
          "description": "The file will be available at /local/kotel_profiles/... WITHOUT authentication."
        }
      }
    },
    "import_profiles": {
      "name": "Import profiles from a file",
      "description": "Load profiles from a file in /config/kotel_profiles/. Version 1.3.0 files are split into boiler and climate profiles automatically.",
      "fields": {
        "file": {
          "name": "File name",
          "description": "JSON file name in the kotel_profiles folder."
        },
        "profiles": {
          "name": "Profiles",
          "description": "Which profiles to import (all by default)."
        },
        "kind": {
          "name": "Profile kind",
          "description": "Import only boiler or only climate profiles."
        },
        "on_conflict": {
          "name": "If the name is taken",
          "description": "Names are compared within the same profile kind."
        }
      }
    }
  }
}
